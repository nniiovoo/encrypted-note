{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. Exactly the app commands in build.rs, plus listening for events. No filesystem, dialog, shell, HTTP or opener plugins (ADR-0001, ADR-0003).",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-status",
    "allow-activity",
    "allow-suggest-passphrase",
    "allow-assess-password",
    "allow-create-vault",
    "allow-confirm-recovery-kit",
    "allow-unlock",
    "allow-set-new-password",
    "allow-lock",
    "allow-list-notes",
    "allow-get-note",
    "allow-create-note",
    "allow-update-note",
    "allow-trash-note",
    "allow-restore-note",
    "allow-delete-forever",
    "allow-empty-trash",
    "allow-set-favorite",
    "allow-show-field",
    "allow-show-wallet-field",
    "allow-hide-field",
    "allow-copy-field",
    "allow-seed-wordlist",
    "allow-check-seed",
    "allow-check-private-key",
    "allow-pick-backup-destination",
    "allow-write-backup",
    "allow-pick-backup-to-open",
    "allow-inspect-backup",
    "allow-replace-with-backup",
    "allow-list-safety-copies",
    "allow-inspect-safety-copy",
    "allow-restore-safety-copy",
    "allow-change-password",
    "allow-set-settings",
    "allow-mark-seed-explainer-seen",
    "allow-dismiss-sharing-guard"
  ]
}
