<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ADR-0009: the pinned Node runtime runs inside the helper's sandbox (inherit) and keeps
         only what V8 needs (allow-jit). Upstream's get-task-allow, dyld-environment, disabled
         library validation and executable-page exceptions are deliberately dropped. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
