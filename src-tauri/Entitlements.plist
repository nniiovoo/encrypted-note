<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ADR-0001: sandboxed. network.client is required by WebKit to render at all (tested
         2026-09-24); the app itself has no network code (CSP + cargo-deny ban). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Backups: only files the owner picks in a save/open panel -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- ADR-0012: the agents' local route binds its Unix socket in this owner-made folder, and
         nowhere else. A file path, not a network entitlement. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/Users/Shared/encrypted-note-keys/</string>
    </array>
</dict>
</plist>
